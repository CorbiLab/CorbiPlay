# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App display name — kept configurable per spec (the "Hockey Trace" name is temporary).
NEXT_PUBLIC_APP_NAME="Hockey Trace"

# When the two Supabase vars above are left empty, the app runs in DEMO MODE:
# every read comes from src/lib/demo/fixtures.ts (the same data as
# supabase/seed.sql) and writes are kept only in local/client state. This is
# what lets the Sprint 1 UI be reviewed in a browser before a real Supabase
# project is wired up. See docs/ARCHITECTURE.md.
